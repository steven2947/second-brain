{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "第二大脑知识推演答案包 v3：显式采用边界",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "library_version",
    "mode",
    "problem",
    "problem_framing",
    "call_ledger",
    "witness_cards",
    "knowledge_groups",
    "argument_relations",
    "system_syntheses",
    "roundtable",
    "verdict",
    "actions",
    "learning_takeaways",
    "continuation_options",
    "next_chat_action",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "session_id": {
      "type": "string",
      "pattern": "^call\\.[a-f0-9]{24}$"
    },
    "library_version": {
      "type": "string",
      "pattern": "^[a-f0-9]{24}$"
    },
    "mode": {
      "enum": [
        "quick",
        "standard",
        "deep"
      ]
    },
    "problem": {
      "type": "object"
    },
    "problem_framing": {
      "type": "object"
    },
    "call_ledger": {
      "type": "object",
      "required": [
        "books_searched",
        "books_with_candidates",
        "queries",
        "retrieval_mode",
        "retrieval_degraded",
        "candidates",
        "admitted",
        "rejected"
      ],
      "properties": {
        "books_searched": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "books_with_candidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "queries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retrieval_mode": {
          "type": "string"
        },
        "retrieval_degraded": {
          "type": "boolean"
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "admitted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rejected": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "witness_cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "card_id",
          "book_id",
          "book_title",
          "author_id",
          "author",
          "chapters",
          "adopted_claim",
          "source_claim_type",
          "source_gap",
          "evidence_ids",
          "excluded_scope",
          "original_card_ref",
          "principle",
          "principle_gap",
          "mechanism",
          "assumptions",
          "user_context_refs",
          "situation_mapping",
          "fit",
          "independent_judgment",
          "confidence",
          "judgment_effect",
          "non_applicable_conditions",
          "misuse_risks",
          "roles",
          "quote"
        ],
        "properties": {
          "card_id": {
            "type": "string",
            "minLength": 1
          },
          "book_id": {
            "type": "string",
            "minLength": 1
          },
          "book_title": {
            "type": "string",
            "minLength": 1
          },
          "author_id": {
            "type": "string",
            "minLength": 1
          },
          "author": {
            "type": [
              "string",
              "null"
            ]
          },
          "chapters": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "adopted_claim": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source_claim_type": {
            "enum": [
              "author_claim",
              "quoted_other",
              "system_inference",
              "unclassified"
            ]
          },
          "source_gap": {
            "type": "boolean"
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "excluded_scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "original_card_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "session_id",
              "library_version",
              "card_id"
            ],
            "properties": {
              "session_id": {
                "type": "string",
                "pattern": "^call\\.[a-f0-9]{24}$"
              },
              "library_version": {
                "type": "string",
                "pattern": "^[a-f0-9]{24}$"
              },
              "card_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "principle": {
            "type": "string"
          },
          "principle_gap": {
            "type": "boolean"
          },
          "mechanism": {
            "type": "string"
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "user_context_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "index"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "fact",
                    "constraint",
                    "assumption"
                  ]
                },
                "index": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "situation_mapping": {
            "type": "string"
          },
          "fit": {
            "enum": [
              "direct",
              "partial",
              "analogy",
              "conflict"
            ]
          },
          "independent_judgment": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "judgment_effect": {
            "type": "string"
          },
          "non_applicable_conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "misuse_risks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "roles": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "support",
                "challenge",
                "boundary",
                "alternative",
                "evidence_auditor",
                "action_translator"
              ]
            }
          },
          "quote": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "evidence_id",
                  "text"
                ],
                "properties": {
                  "evidence_id": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "knowledge_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "argument_relations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "system_syntheses": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "roundtable": {
      "type": "object"
    },
    "verdict": {
      "type": "object"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "learning_takeaways": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "continuation_options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "next_chat_action": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "book_id",
          "book_title",
          "author",
          "chapter",
          "excerpt",
          "card_ids"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "book_id": {
            "type": "string",
            "minLength": 1
          },
          "book_title": {
            "type": "string",
            "minLength": 1
          },
          "author": {
            "type": [
              "string",
              "null"
            ]
          },
          "chapter": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "card_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
