{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "问题档案事件日志 v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "problem_id", "question", "goal", "events", "state_hash"],
  "properties": {
    "schema_version": {"const": 1},
    "clarification_limit": {"type": "integer", "enum": [3, 5], "description": "新建为5；历史缺省为3，不得修改既有档案上限以重置问诊。"},
    "problem_id": {"type": "string", "pattern": "^problem\\.[a-f0-9]{32}$"},
    "question": {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S"},
    "goal": {"enum": ["explain", "analyze", "compare", "act", "review"]},
    "events": {"type": "array", "items": {"type": "object"}},
    "state_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
