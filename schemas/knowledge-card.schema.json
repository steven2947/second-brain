{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "第二大脑知识卡片 v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "book_id", "author_id", "kind", "title", "statement", "conditions", "boundaries", "evidence_ids"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "book_id": {"type": "string", "minLength": 1},
    "author_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["claim", "definition", "method", "case", "counterexample"]},
    "title": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "reasoning": {"type": "string"},
    "keywords": {"type": "array", "items": {"type": "string"}},
    "trigger_questions": {"type": "array", "items": {"type": "string"}},
    "application_notes": {"type": "string"},
    "source_claim_type": {"enum": ["author_claim", "quoted_other", "system_inference"]},
    "source_cases": {"type": "array", "items": {"type": "object", "required": ["summary", "paragraph_id"], "properties": {"summary": {"type": "string"}, "paragraph_id": {"type": "string"}}, "additionalProperties": false}},
    "conditions": {"type": "array", "items": {"type": "string"}},
    "boundaries": {"type": "array", "items": {"type": "string"}},
    "steps": {"type": "array", "items": {"type": "string"}},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
