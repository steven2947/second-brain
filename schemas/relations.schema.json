{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "第二大脑知识关系 v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "edges"],
  "properties": {
    "schema_version": {"const": 1},
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to", "type", "basis", "rationale", "evidence_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "type": {"enum": ["depends_on", "contrasts_with", "composes_with", "applies_to", "limited_by", "supported_by"]},
          "basis": {"enum": ["source", "inference"]},
          "rationale": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
